# ===== Trình duyệt (bắt đầu bằng VITE_) =====
# Bỏ trống 2 dòng Supabase => web chạy CHẾ ĐỘ DEMO (dữ liệu lưu trong trình duyệt, thanh toán giả lập)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Tên shop, hotline, ngân hàng: sửa trong web ở Quản trị > Cài đặt cửa hàng. Các biến dưới chỉ là giá trị dự phòng.
VITE_SHOP_NAME=Tiểu Hoa BJD
VITE_HOTLINE=1800 0000
# Chuyển khoản qua mã VietQR (mã ngân hàng theo https://api.vietqr.io/v2/banks, vd: VCB, TCB, MB)
VITE_BANK_ID=VCB
VITE_BANK_ACCOUNT=0123456789
VITE_BANK_ACCOUNT_NAME=TIEU HOA BJD

# ===== Chỉ đặt trên Vercel (Environment Variables), KHÔNG đưa vào trình duyệt =====
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Địa chỉ web (để cổng thanh toán quay về)
SITE_URL=https://ten-web.vercel.app
# VNPay (sandbox: https://sandbox.vnpayment.vn/devreg/)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# MoMo (sandbox: https://developers.momo.vn)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
# SePay (https://my.sepay.vn): báo tiền chuyển khoản về để tự xác nhận đơn. Đặt cùng một khóa ở SePay (Webhook, xác thực API Key) và ở đây.
SEPAY_API_KEY=
